# Unraid's standard user-share path. Verify this exists before deployment.
APPDATA_ROOT=/mnt/user/appdata
APP_PORT=8790

POSTGRES_DB=kitchen_planner
POSTGRES_USER=kitchen_planner
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://kitchen_planner:replace-with-a-long-random-password@db:5432/kitchen_planner

APP_VERSION=0.6.4.7
DEMO_MODE=true
SEED_SYNTHETIC_DATA=true
AUTH_MODE=household
APP_HOUSEHOLD_NAME=Kitchen
APP_TIME_ZONE=America/Vancouver
HOUSEHOLD_SESSION_SECRET=replace-before-importing-real-data
HOUSEHOLD_USER_1_NAME=Owner
HOUSEHOLD_USER_1_PIN=choose-a-pin
HOUSEHOLD_USER_2_NAME=Member
HOUSEHOLD_USER_2_PIN=choose-a-different-pin

# Server-side only. Create a project API key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=
OPENAI_ECONOMY_MODEL=gpt-5.4-mini
OPENAI_ROUTINE_MODEL=gpt-5.4
# Used for advanced refinements and the default Balanced weekly-plan mode.
OPENAI_FALLBACK_MODEL=gpt-5.6-terra
OPENAI_RECONCILIATION_MODEL=gpt-5.4
# Used only when the household explicitly selects Deep weekly planning.
OPENAI_PLANNING_MODEL=gpt-5.6-sol
OPENAI_PLANNING_REASONING_EFFORT=high
OPENAI_PLANNING_TIMEOUT_MS=1800000
OPENAI_ECONOMY_INPUT_USD_PER_M=0.75
OPENAI_ECONOMY_CACHED_INPUT_USD_PER_M=0.075
OPENAI_ECONOMY_OUTPUT_USD_PER_M=4.5
OPENAI_ROUTINE_INPUT_USD_PER_M=2.5
OPENAI_ROUTINE_CACHED_INPUT_USD_PER_M=0.25
OPENAI_ROUTINE_OUTPUT_USD_PER_M=15
OPENAI_FALLBACK_INPUT_USD_PER_M=2.5
OPENAI_FALLBACK_CACHED_INPUT_USD_PER_M=0.25
OPENAI_FALLBACK_OUTPUT_USD_PER_M=15
OPENAI_PLANNING_INPUT_USD_PER_M=5
OPENAI_PLANNING_CACHED_INPUT_USD_PER_M=0.5
OPENAI_PLANNING_OUTPUT_USD_PER_M=30
